# Copy to .env.local for development, or set these in the Vercel dashboard.
# With none of them set, the app runs unauthenticated against a local SQLite
# file in ./data — which is what you want on your own machine.

# --- Access -----------------------------------------------------------------
# The shared family passphrase. Setting this turns on the sign-in screen.
# Leave it unset locally; it is REQUIRED in production.
MOTOR_HUB_PASSWORD=

# Optional. Signs session cookies. Set it to any long random string so that
# changing the passphrase does not sign everyone out. Generate one with:
#   node -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
MOTOR_HUB_SESSION_SECRET=

# --- Database (Turso) -------------------------------------------------------
# Unset locally: the app uses ./data/motor-hub.db.
# From `turso db show <name>` and `turso db tokens create <name>`.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- File storage (Cloudflare R2) -------------------------------------------
# Unset locally: receipts and photos are written to ./data/uploads.
# All four are needed together; set none of them to stay on local disk.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional override; defaults to https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
