{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": ".test-build",
    "jsx": "react-jsx",
    "incremental": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/lib/dates.ts",
    "src/lib/due.ts",
    "src/lib/format.ts",
    "src/lib/domain.ts",
    "src/lib/part-logic.ts",
    "src/lib/fleet.ts",
    "src/lib/types.ts",
    "src/lib/starter-schedules.ts",
    "tests/**/*.ts"
  ]
}
